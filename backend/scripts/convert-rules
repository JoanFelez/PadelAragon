#!/usr/bin/env python3
"""Convert the rulebook PDFs in backend/rules/ into backend/rules/reglamento.md.

Output uses `## Art. N (Tag) Title` headings, which the Worker splits on.
Requires `pdftotext` (poppler-utils). The sources are public federation documents and are versioned together with the output.

Usage: backend/scripts/convert-rules [rules_dir]
"""
import re
import subprocess
import sys
from pathlib import Path

rules_dir = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent / "rules"
FIP_PDF = rules_dir / "fip-reglas-2026.pdf"
LIGA_PDF = rules_dir / "liga-aragon-2026.pdf"
NT_PDF = rules_dir / "normativa_tecnica_2026.pdf"
# Short FAP documents: (file, title shown to the user)
FAP_DOCS = [
    ("reglamento_fap_2026.pdf", "Reglamento Circuito Aragonés Absoluto 2026 (FAP)"),
    ("master_fap_2026.pdf", "Master Final Circuito Aragonés 2026 (FAP)"),
    ("veteranos_fap_2026.pdf", "Circuito Aragonés de Veteranos 2026 (FAP)"),
    ("puntos_veteranos_fap_2026.pdf", "Puntos Circuito de Veteranos 2026 (FAP)"),
    ("sistema_puntos_paf_2026.pdf", "Sistema de puntos Circuito Absoluto 2026 (FAP)"),
]
MAX_SECTION_CHARS = 5000  # the Worker injects only ~20k chars of rules per question


def pdf_lines(path: Path):
    out = subprocess.run(["pdftotext", "-layout", str(path), "-"], check=True, capture_output=True, text=True).stdout
    return [l.replace("\f", "").rstrip() for l in out.splitlines()]


def clean(lines):
    text = "\n".join(l.strip() for l in lines)
    return re.sub(r"\n{3,}", "\n\n", text).strip()


def convert_liga(path: Path):
    sections, current, topic = [], None, ""
    for line in pdf_lines(path):
        s = line.strip()
        if re.match(r"^\d+\s*\|\s*Reglamento de la Liga", s) or re.match(r"^\d+\|", s):
            continue
        top = re.match(r"^(\d+)\.\s+([A-ZÁÉÍÓÚÑ][^a-z]*)$", s)
        if top:
            topic = top.group(2).strip().rstrip(".:")
            current = None
            continue
        clause = re.match(r"^(\d+\.\d+(?:\.\d+)*)\.?\s{2,}(.*)$", line.strip()) or re.match(r"^(\d+\.\d+(?:\.\d+)*)\.?\s+(\S.*)$", s)
        if clause:
            current = {"heading": f"Art. {clause.group(1)} (Liga) {topic.capitalize()}", "lines": [clause.group(2)]}
            sections.append(current)
        elif current is not None:
            current["lines"].append(line)
    return sections


HEADINGS_FIP = [
    (re.compile(r"^REGLA\s+(\d+)\.\s*(.+)$"), lambda m: f"Art. {m.group(1)} (FIP) {m.group(2).title()}"),
    (re.compile(r"^(LA PISTA|LA PELOTA|LA PALA)$"), lambda m: f"{m.group(1).title()} (FIP)"),
    (re.compile(r"^(NORMAS DE ETIQUETA Y DE CONDUCTA)$"), lambda m: f"{m.group(1).capitalize()} (FIP)"),
]


def convert_fip(path: Path):
    sections, current = [], None
    for line in pdf_lines(path):
        s = line.strip()
        if re.search(r"\s{2,}\d+$", line) or re.fullmatch(r"\d+", s):  # index entries and page numbers
            continue
        for pattern, fmt in HEADINGS_FIP:
            m = pattern.match(s)
            if m:
                current = {"heading": fmt(m), "lines": []}
                sections.append(current)
                break
        else:
            if current is not None:
                current["lines"].append(line)
    return sections


def split_long(heading, lines):
    """Split a long section into paragraph-aligned chunks so each fits the Worker's prompt budget."""
    text = clean(lines)
    if len(text) <= MAX_SECTION_CHARS:
        return [{"heading": heading, "lines": text.splitlines()}]
    chunks, buf = [], ""
    for para in re.split(r"\n\n", text):
        if buf and len(buf) + len(para) + 2 > MAX_SECTION_CHARS:
            chunks.append(buf)
            buf = ""
        buf = f"{buf}\n\n{para}" if buf else para
    if buf:
        chunks.append(buf)
    return [{"heading": f"{heading} (parte {i})", "lines": c.splitlines()} for i, c in enumerate(chunks, 1)]


def convert_nt(path: Path):
    """Normativa Técnica: sections per 'N.M' clause, grouped under 'ARTÍCULO N'."""
    sections, article, head, cur = [], None, "", None
    article_re = re.compile(r"^ARTÍCULO\s+(\d+)\.?-?\s*(.*)$")
    clause_re = re.compile(r"^(\d{1,2})\.(\d{1,2})\.?\s+\S")
    started = False
    for line in pdf_lines(path):
        s = line.strip()
        m = article_re.match(s)
        if m and not re.search(r"\s\d+$", s) and int(m.group(1)) == int(article or 0) + 1:  # in sequence: skips the index
            started = True
            article, head = m.group(1), m.group(2).strip().rstrip(".").capitalize()
            cur = {"heading": f"Art. {article} (NT) {head}", "lines": []}
            sections.append(cur)
            continue
        if not started or re.fullmatch(r"\d+", s):
            continue
        c = clause_re.match(s)
        if c and c.group(1) == article:
            cur = {"heading": f"Art. {c.group(1)}.{c.group(2)} (NT) {head}", "lines": [s]}
            sections.append(cur)
        elif cur is not None:
            cur["lines"].append(line)
    out = []
    for sec in sections:
        out.extend(split_long(sec["heading"], sec["lines"]))
    return out


def convert_doc(path: Path, title: str):
    return split_long(title, pdf_lines(path))


def render(sections):
    return "\n\n".join(f"## {s['heading']}\n{clean(s['lines'])}" for s in sections if clean(s["lines"]))


parts = []
for pdf, fn in ((LIGA_PDF, convert_liga), (FIP_PDF, convert_fip)):
    if pdf.exists():
        parts.append(render(fn(pdf)))
    else:
        print(f"missing {pdf.name}, skipped", file=sys.stderr)
if NT_PDF.exists():
    parts.append(render(convert_nt(NT_PDF)))
for name, title in FAP_DOCS:
    pdf = rules_dir / name
    if pdf.exists():
        parts.append(render(convert_doc(pdf, title)))
if not parts:
    sys.exit("no rulebook PDFs found in " + str(rules_dir))

target = rules_dir / "reglamento.md"
target.write_text("# Reglamento\n\n" + "\n\n".join(parts) + "\n", encoding="utf-8")
print(f"wrote {target} ({target.stat().st_size} bytes, {sum(p.count(chr(10) + '## ') + 1 for p in parts)} sections)")
